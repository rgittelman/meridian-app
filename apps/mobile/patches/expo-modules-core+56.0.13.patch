+package expo.modules.kotlin.types
+
+import kotlin.reflect.KClass
+import kotlin.reflect.KClassifier
+import kotlin.reflect.KType
+import kotlin.reflect.KTypeProjection
+
+/**
+ * Compatibility shim: pika IR transformer generates LazyKType instances and casts
+ * them to KType. In the old expo-modules-core API, LazyKType implemented KType.
+ */
+class LazyKType(
+  val kClass: KClass<*>,
+  override val isMarkedNullable: Boolean = false,
+  private val kTypeProvider: (() -> KType)? = null
+) : KType {
+  override val classifier: KClassifier get() = kClass
+  override val arguments: List<KTypeProjection> get() = emptyList()
+  override val annotations: List<Annotation> get() = emptyList()
+
+  val kType: KType get() = kTypeProvider?.invoke() ?: this
+}
