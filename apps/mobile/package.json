{
  "name": "@meridian/mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-dev-client",
        "expo-dev-launcher",
        "expo-dev-menu"
      ]
    }
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "dev:ios": "expo run:ios",
    "dev:android": "expo run:android",
    "start:dev-client": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test:capture": "npx tsx --test src/services/capture/captureIntelligenceAudit.test.ts",
    "test:calendar": "npx tsx --test src/services/calendar/calendarIntelligenceCorrection.test.ts",
    "test:focus": "npx tsx --test src/services/resurfacing/focusIntelligenceV1.test.ts src/store/focusStore.test.ts",
    "test:plan": "npx tsx --test src/services/plan/humanizePlanTitle.test.ts src/services/plan/planIntelligenceV1.test.ts",
    "test:focus-format": "npx tsx --test src/components/focus/completionFormat.test.ts",
    "test:shared": "npx tsx --test src/components/shared/shared.test.ts",
    "test:life": "npx tsx --test src/components/life/lifeSummary.test.ts src/services/engagement/observeGradeChildAttribution.test.ts",
    "test:engagement": "npx tsx --test src/services/engagement/observeGradeChildAttribution.test.ts src/services/engagement/observePrepConnection.test.ts",
    "test:profile": "npx tsx --test src/store/profileStore.test.ts"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/native": "^7.2.5",
    "expo": "~56.0.5",
    "expo-auth-session": "~7.0.11",
    "expo-blur": "~56.0.3",
    "expo-constants": "~56.0.16",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.18",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-location": "~56.0.15",
    "expo-notifications": "~56.0.15",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^1.16.0",
    "nanoid": "^5.0.9",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  }
}
